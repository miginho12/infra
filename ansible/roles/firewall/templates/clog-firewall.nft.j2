#!/usr/sbin/nft -f
# {{ ansible_managed }} — infra/ansible/roles/firewall (ADR-099)
#
# ⚠ flush ruleset 금지: k3s(kube-proxy·flannel·netpol)와 docker 규칙이 같은 nftables(iptables-nft)에 있다.
#   우리 테이블 하나만 지우고 다시 만든다(아래 3줄 — 테이블이 없어도 delete 가 실패하지 않게 먼저 빈 테이블 선언).
# 정책: 호스트로 들어오는(input) 것은 기본 차단, LAN 에서 NodePort 로 가는 것(forward) 차단. 나가는 것은 그대로.
table inet clog_host
delete table inet clog_host

table inet clog_host {
	set cluster_v4 {
		type ipv4_addr
		flags interval
		elements = { {{ firewall_cluster_cidrs | join(', ') }} }
	}

	set lan_ifaces {
		type ifname
		elements = { {{ firewall_lan_ifaces | map('to_json') | join(', ') }} }
	}

	chain input {
		type filter hook input priority filter; policy drop;

		iif "lo" accept
		ct state established,related accept
		ct state invalid drop

		# ICMP(ping·PMTU)·ICMPv6(이웃 탐색 — 막으면 IPv6 가 끊긴다)
		meta l4proto { icmp, ipv6-icmp } accept

		# Tailscale(tailnet 안 — 접근은 Tailscale ACL 이 정한다): SSH·NodePort·kubectl
		iifname "tailscale0" accept

		# 클러스터 안: Pod → 호스트(kubelet·node-exporter·apiserver), flannel, docker(로컬 개발 compose)
		iifname { "cni0", "flannel.1", "docker0" } accept
		iifname "br-*" accept
		ip saddr @cluster_v4 accept

		# 집 LAN: SSH(키 전용 — ssh_hardening), Tailscale 직접 연결, mDNS, DHCP 응답
		iifname @lan_ifaces tcp dport 22 accept
		iifname @lan_ifaces udp dport { 41641, 5353, 68 } accept
		iifname @lan_ifaces udp dport 546 meta nfproto ipv6 accept

		# 막힌 것: 6443(apiserver)·10250(kubelet)·9100(node-exporter, 인증 없음)·8472(flannel VXLAN) 등
		counter comment "clog_host input drop"
	}

	chain forward {
		# kube-proxy 가 NodePort 를 DNAT 해 Pod 로 넘기므로 input 이 아니라 여기서 본다(원래 목적지 포트 기준)
		type filter hook forward priority filter - 10; policy accept;

		iifname @lan_ifaces ct original proto-dst 30000-32767 counter drop comment "clog_host LAN→NodePort drop"
	}
}
